  "rules": [
    {
      "id": 1,
      "name": "simple",
      "layout": {
        "top": "initial",
        "bottom": "final"
      },
      "zh": "聲母符號和韻母符號拼合起來就可以表達一個字音，拼寫時聲母在上，韻母在下。",
      "example": {
        "romanization": "keq",
        "hanzi": "個"
      }
    },
    {
      "id": 2,
      "name": "with_medial",
      "layout": {
        "top": "initial",
        "below": "medial",
        "beside": "final"
      },
      "zh": "拼寫時聲母在上，介母在其下，韻母在介母之右。",
      "example": {
        "romanization": "tiau",
        "hanzi": "鳥"
      }
    },
    {
      "id": 3,
      "name": "implicit_i",
      "layout": {
        "top": "initial",
        "bottom": "final"
      },
      "zh": "ch(i)、c(i)、j(i) 和 sh(i)、zh(i) 視為已含介母 i，因此不用再標出介音 i。",
      "example": {
        "romanization": "shian",
        "hanzi": "向"
      },
      "implicit_i_initials": [
        "ch",
        "c",
        "j",
        "sh",
        "zh"
      ]
    },
    {
      "id": 4,
      "name": "compound_final",
      "layout": {
        "top": "initial",
        "bottom": "final_part_1",
        "beside": "final_part_2"
      },
      "zh": "aeq、oeq、eoq、ai、ei 等有專門寫法（下+右布局），同時按照介音字的方式進行拼寫。",
      "example": {
        "romanization": "maeq",
        "hanzi": "襪"
      },
      "compound_finals": {
        "aeq": [
          "ae",
          "-q"
        ],
        "oeq": [
          "oe",
          "-q"
        ],
        "eoq": [
          "eon",
          "-q"
        ],
        "ai": [
          "a",
          "i"
        ],
        "ei": [
          "e",
          "i"
        ]
      }
    },
    {
      "id": 5,
      "name": "yu",
      "layout": {
        "top": "initial",
        "bottom": "final"
      },
      "zh": "由於目前撮口音 iu 基本上不區分尖團，所以不再單獨設立 yu 韻母；如需表記，用 y+u（grid yu）。",
      "example": {
        "romanization": "yu",
        "hanzi": null
      }
    }
  ],
